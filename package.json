{
  "name": "ewidencja-faktur",
  "productName": "Ewidencja Faktur",
  "version": "0.3.0",
  "description": "Simple offline invoice ledger for Windows, designed for non-technical users.",
  "author": "kolodziejczyks",
  "license": "MIT",
  "private": true,
  "main": "./out/main/index.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/kolodziejczyks/ewidencja-faktur.git"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "test:e2e": "npm run build && npm run release-notes && node tests/e2e/smoke.mjs",
    "icon": "electron scripts/make-icon.cjs",
    "release-notes": "node scripts/release-notes.mjs",
    "dist": "npm run build && npm run release-notes && electron-builder --win --publish never",
    "release": "npm run build && npm run release-notes && electron-builder --win --publish always"
  },
  "dependencies": {
    "@tesseract.js-data/pol": "^1.0.0",
    "electron-updater": "^6.8.11",
    "mammoth": "^1.13.0",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "pdfjs-dist": "^6.4.299",
    "playwright-core": "^1.64.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "recharts": "^3.10.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
